[
  {
    "start": 14.634444339175744,
    "end": 16.565209379441022,
    "text": "I used to wake before the sun",
    "section": "Verse 1"
  },
  {
    "start": 18.11601042160114,
    "end": 20.166829464708666,
    "text": "And wrestle code till it was done",
    "section": "Verse 1"
  },
  {
    "start": 21.717630506868783,
    "end": 23.928521553765986,
    "text": "A tiny bug, a stubborn line",
    "section": "Verse 1"
  },
  {
    "start": 24.3788275698721,
    "end": 27.430096636665084,
    "text": "And then—at last—the build was mine",
    "section": "Verse 1"
  },
  {
    "start": 28.80081667456182,
    "end": 30.911662719090476,
    "text": "I'd chase the truth through nested loops",
    "section": "Verse 1"
  },
  {
    "start": 32.36241875888204,
    "end": 34.413237801989574,
    "text": "And count my wins in crooked groups",
    "section": "Verse 1"
  },
  {
    "start": 35.90401184272856,
    "end": 38.585217906205585,
    "text": "Now I just ask, and there it goes",
    "section": "Verse 1"
  },
  {
    "start": 38.585217906205585,
    "end": 41.43639696826148,
    "text": "A thousand answers, one neat row",
    "section": "Verse 1"
  },
  {
    "start": 42.417542094455854,
    "end": 43.34926694045175,
    "text": "It's fast",
    "section": "Pre-Chorus"
  },
  {
    "start": 43.48015400410678,
    "end": 44.17128747433265,
    "text": "It's clean",
    "section": "Pre-Chorus"
  },
  {
    "start": 44.34227310061602,
    "end": 46.20685626283368,
    "text": "It's almost everything I dreamed",
    "section": "Pre-Chorus"
  },
  {
    "start": 46.20685626283368,
    "end": 47.87094661190965,
    "text": "A world of doors at my command",
    "section": "Pre-Chorus"
  },
  {
    "start": 47.87094661190965,
    "end": 51.89026078028747,
    "text": "But something slips right through my hands",
    "section": "Pre-Chorus"
  },
  {
    "start": 51.951330265848675,
    "end": 54.04313701431493,
    "text": "I can build anything now",
    "section": "Chorus"
  },
  {
    "start": 54.21352556237219,
    "end": 55.744788343558284,
    "text": "Anything now",
    "section": "Chorus"
  },
  {
    "start": 55.83509918200409,
    "end": 58.237430470347654,
    "text": "But I don't code anymore",
    "section": "Chorus"
  },
  {
    "start": 58.237430470347654,
    "end": 59.97912065439673,
    "text": "I don't code anymore",
    "section": "Chorus"
  },
  {
    "start": 59.97912065439673,
    "end": 61.71057770961145,
    "text": "I ask the machine to sing",
    "section": "Chorus"
  },
  {
    "start": 61.74083026584867,
    "end": 63.442481595092026,
    "text": "I watch it hand me the thing",
    "section": "Chorus"
  },
  {
    "start": 63.442481595092026,
    "end": 65.28426891615543,
    "text": "And still I stand at the door",
    "section": "Chorus"
  },
  {
    "start": 65.28426891615543,
    "end": 68.41708588957056,
    "text": "I don't code anymore",
    "section": "Chorus"
  },
  {
    "start": 71.02012808349147,
    "end": 73.411665085389,
    "text": "No red squiggles in the dark",
    "section": "Verse 2"
  },
  {
    "start": 74.42254743833017,
    "end": 77.03424098671728,
    "text": "No midnight fights with parser sparks",
    "section": "Verse 2"
  },
  {
    "start": 77.96506641366224,
    "end": 79.72631878557875,
    "text": "No coffee ring on logic maps",
    "section": "Verse 2"
  },
  {
    "start": 79.72631878557875,
    "end": 81.56762808349147,
    "text": "No victory from fixing traps",
    "section": "Verse 2"
  },
  {
    "start": 81.56762808349147,
    "end": 83.30886622390892,
    "text": "It drafts the screen, it names the files",
    "section": "Verse 2"
  },
  {
    "start": 83.30886622390892,
    "end": 85.11014705882353,
    "text": "It skips the pain, it cuts the miles",
    "section": "Verse 2"
  },
  {
    "start": 85.11014705882353,
    "end": 86.851385199241,
    "text": "It makes the hard part look like art",
    "section": "Verse 2"
  },
  {
    "start": 86.851385199241,
    "end": 91.92517708333332,
    "text": "And leaves my old joy out apart",
    "section": "Verse 2"
  },
  {
    "start": 91.92517708333332,
    "end": 92.71546875,
    "text": "It's smart",
    "section": "Pre-Chorus"
  },
  {
    "start": 92.96571875,
    "end": 93.53589583333333,
    "text": "It's quick",
    "section": "Pre-Chorus"
  },
  {
    "start": 93.8661875,
    "end": 95.68713541666666,
    "text": "It gives me almost all I pick",
    "section": "Pre-Chorus"
  },
  {
    "start": 95.68713541666666,
    "end": 97.40803125,
    "text": "I reach for keys that aren't there",
    "section": "Pre-Chorus"
  },
  {
    "start": 97.40803125,
    "end": 100.9200347826087,
    "text": "And feel the ghost of my own care",
    "section": "Pre-Chorus"
  },
  {
    "start": 100.9200347826087,
    "end": 103.39100869565218,
    "text": "I can build anything now",
    "section": "Chorus"
  },
  {
    "start": 103.88132173913044,
    "end": 105.11175652173914,
    "text": "Anything now",
    "section": "Chorus"
  },
  {
    "start": 105.20189565217392,
    "end": 107.56292173913045,
    "text": "But I don't code anymore",
    "section": "Chorus"
  },
  {
    "start": 107.56292173913045,
    "end": 109.27356521739131,
    "text": "I don't code anymore",
    "section": "Chorus"
  },
  {
    "start": 109.30367826086957,
    "end": 110.99431304347827,
    "text": "I ask the machine to sing",
    "section": "Chorus"
  },
  {
    "start": 111.0444347826087,
    "end": 112.70515652173914,
    "text": "I watch it hand me the thing",
    "section": "Chorus"
  },
  {
    "start": 112.70515652173914,
    "end": 114.56596521739131,
    "text": "And still I stand at the door",
    "section": "Chorus"
  },
  {
    "start": 114.56596521739131,
    "end": 117.53715652173913,
    "text": "I don't code anymore",
    "section": "Chorus"
  },
  {
    "start": 123.60002019386107,
    "end": 126.6806421647819,
    "text": "Remember when a broken line",
    "section": "Bridge"
  },
  {
    "start": 126.6806421647819,
    "end": 130.28136914378027,
    "text": "Could teach me patience, make me shine?",
    "section": "Bridge"
  },
  {
    "start": 130.28136914378027,
    "end": 133.17190630048466,
    "text": "When every fix was hard-earned light",
    "section": "Bridge"
  },
  {
    "start": 133.7820759289176,
    "end": 139.00313004846524,
    "text": "And I could lose myself all night",
    "section": "Bridge"
  },
  {
    "start": 139.00313004846524,
    "end": 140.24338045234248,
    "text": "I don't miss the pain",
    "section": "Bridge"
  },
  {
    "start": 140.24338045234248,
    "end": 141.0235379644588,
    "text": "I miss the proof",
    "section": "Bridge"
  },
  {
    "start": 141.0235379644588,
    "end": 142.8639095315024,
    "text": "The quiet click of finding truth",
    "section": "Bridge"
  },
  {
    "start": 142.8639095315024,
    "end": 144.48423667205168,
    "text": "I miss the mess, the climb, the grit",
    "section": "Bridge"
  },
  {
    "start": 144.48423667205168,
    "end": 148.29514869565216,
    "text": "The little thrill of making it",
    "section": "Bridge"
  },
  {
    "start": 148.29514869565216,
    "end": 150.50592347826088,
    "text": "I can build anything now",
    "section": "Final Chorus"
  },
  {
    "start": 150.89616608695653,
    "end": 152.16657304347828,
    "text": "Anything now",
    "section": "Final Chorus"
  },
  {
    "start": 152.29671391304348,
    "end": 154.59761391304346,
    "text": "But I don't code anymore",
    "section": "Final Chorus"
  },
  {
    "start": 154.59761391304346,
    "end": 156.17823217391305,
    "text": "I don't code anymore",
    "section": "Final Chorus"
  },
  {
    "start": 156.17823217391305,
    "end": 157.9389208695652,
    "text": "So give me one old stubborn file",
    "section": "Final Chorus"
  },
  {
    "start": 157.9389208695652,
    "end": 159.70952347826088,
    "text": "One bug that makes me stay awhile",
    "section": "Final Chorus"
  },
  {
    "start": 159.7396252173913,
    "end": 161.48030608695652,
    "text": "I want the struggle back once more",
    "section": "Final Chorus"
  },
  {
    "start": 161.48030608695652,
    "end": 165.5918243478261,
    "text": "I want to code once more",
    "section": "Final Chorus"
  },
  {
    "start": 170.7740427046263,
    "end": 173.10449110320286,
    "text": "Let me compile my hands",
    "section": "Outro"
  },
  {
    "start": 174.23478149466192,
    "end": 178.36561423487544,
    "text": "Let me compile my hands",
    "section": "Outro"
  },
  {
    "start": 178.39566975088965,
    "end": 182.18642989323843,
    "text": "I can build anything now",
    "section": "Outro"
  },
  {
    "start": 183.81682704626334,
    "end": 186.62737793594306,
    "text": "But I miss the way I began",
    "section": "Outro"
  }
